{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stokeai.example/schemas/evidence.schema.json",
  "title": "Super Trends evidence document",
  "description": "Per-pick evidence document (BUILD_PROMPT Justification, S3-T08, ADR-067). The UI, narratives, CLI and MCP render from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticker",
    "date",
    "side",
    "rank",
    "days_on_list",
    "display_score",
    "composite",
    "confidence",
    "band",
    "regime",
    "market_regime",
    "supertrend",
    "ripster",
    "cloud_label",
    "invalidation",
    "levels",
    "factors",
    "confidence_deductions",
    "adjustments",
    "flags",
    "also_qualified",
    "config_hash",
    "config_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ticker": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "side": {
      "enum": [
        "buy",
        "sell"
      ]
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "days_on_list": {
      "type": "integer",
      "minimum": 1
    },
    "display_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "composite": {
      "type": "number",
      "minimum": -100,
      "maximum": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "band": {
      "enum": [
        "Strong Buy",
        "Buy",
        "Neutral, leaning up",
        "Neutral, leaning down",
        "Sell",
        "Strong Sell"
      ]
    },
    "regime": {
      "type": "string",
      "minLength": 1
    },
    "market_regime": {
      "type": [
        "string",
        "null"
      ]
    },
    "supertrend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dir_d",
        "dir_w",
        "bars_since_flip",
        "line",
        "distance_atr"
      ],
      "properties": {
        "dir_d": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            -1,
            0,
            1,
            null
          ]
        },
        "dir_w": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            -1,
            0,
            1,
            null
          ]
        },
        "bars_since_flip": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "line": {
          "type": [
            "number",
            "null"
          ]
        },
        "distance_atr": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "ripster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bias",
        "stack",
        "bars_since_stack_flip",
        "c2_dir",
        "c3_dir",
        "c3_top",
        "c3_bot",
        "dir_w"
      ],
      "properties": {
        "bias": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            -1,
            0,
            1,
            null
          ]
        },
        "stack": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            -1,
            0,
            1,
            null
          ]
        },
        "bars_since_stack_flip": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "c2_dir": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            -1,
            0,
            1,
            null
          ]
        },
        "c3_dir": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            -1,
            0,
            1,
            null
          ]
        },
        "c3_top": {
          "type": [
            "number",
            "null"
          ]
        },
        "c3_bot": {
          "type": [
            "number",
            "null"
          ]
        },
        "dir_w": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            -1,
            0,
            1,
            null
          ]
        }
      }
    },
    "cloud_label": {
      "const": "34/50"
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rule"
      ],
      "properties": {
        "level": {
          "type": [
            "number",
            "null"
          ]
        },
        "rule": {
          "enum": [
            "daily close below the Supertrend line",
            "daily close above the Supertrend line"
          ]
        }
      }
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support",
        "resistance",
        "fib",
        "cloud_34_50",
        "next_target"
      ],
      "properties": {
        "support": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 3
        },
        "resistance": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 3
        },
        "fib": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "pattern": "^\\d+(\\.\\d)?$"
          }
        },
        "cloud_34_50": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "next_target": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "factors": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "weight",
          "contribution",
          "quality",
          "reasons"
        ],
        "properties": {
          "id": {
            "enum": [
              "supertrend",
              "sma",
              "macd",
              "divergence",
              "mean_reversion",
              "fibonacci",
              "levels",
              "volatility",
              "volume_osc",
              "flow",
              "fundamentals",
              "ripster"
            ]
          },
          "score": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "contribution": {
            "type": "number"
          },
          "quality": {
            "enum": [
              "ok",
              "degraded",
              "missing",
              "daily_estimate"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "confidence_deductions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "points",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "adjustments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      },
      "uniqueItems": true
    },
    "also_qualified": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker",
          "display_score",
          "correlation"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "display_score": {
            "type": "number"
          },
          "correlation": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
