# Copy to .env for native development (read only when SUPERTRENDS_ENV=dev).
# Never put real keys in this file; .env is git-ignored. See ARCHITECTURE section 13.4.
SUPERTRENDS_ENV=dev
SUPERTRENDS_DATABASE_URL=postgresql+psycopg://supertrends:supertrends@localhost:5432/supertrends
SUPERTRENDS_MARKET_PROVIDER=fixture
SUPERTRENDS_FUNDAMENTALS_PROVIDER=fixture
SUPERTRENDS_MASSIVE_API_KEY=
SUPERTRENDS_MASSIVE_BASE_URL=https://api.massive.com
SUPERTRENDS_PROVIDER_RATE_PER_MIN=5
SUPERTRENDS_NARRATIVE_PROVIDER=template
SUPERTRENDS_LLM_BASE_URL=http://localhost:8089/v1
SUPERTRENDS_LLM_MODEL=mock
SUPERTRENDS_LLM_API_KEY=
SUPERTRENDS_API_TOKEN=dev-token
SUPERTRENDS_SCORING_CONFIG=config/scoring.yaml
SUPERTRENDS_LOG_LEVEL=debug
SUPERTRENDS_SOURCE_URL=https://github.com/mohnishbasha/stokeai-trading-supertrends
SUPERTRENDS_ALLOWED_HOSTS=localhost
SUPERTRENDS_BIND=127.0.0.1:8080
